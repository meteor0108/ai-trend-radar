   "title": "Florilegium: Procedural Flowers in LaTeX",
   "url": "https://github.com/kevinraymond/florilegium",
   "discussUrl": "https://news.ycombinator.com/item?id=50305637",
   "points": 68,
   "comments": 10,
   "published": "2026-10-31T00:48:12+09:00",
