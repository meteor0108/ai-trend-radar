   "title": "Why a program doesn't work when run from a batch file, but works when clicked",
   "url": "https://devblogs.microsoft.com/oldnewthing/20261026-00/?p=112797/",
   "discussUrl": "https://news.ycombinator.com/item?id=50251070",
   "points": 105,
