   "title": "A Working Nintendo in ~1GB of Qwen Weights",
   "url": "https://github.com/dbreunig/nesformer",
   "discussUrl": "https://news.ycombinator.com/item?id=50306442",
   "points": 85,
   "comments": 70,
   "published": "2026-10-31T01:40:22+09:00",
